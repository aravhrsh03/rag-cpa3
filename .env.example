# Copy this file to .env and fill in your key(s). Never commit the real .env.

# LLM_PROVIDER is the one switch that drives every LLM call in the project:
# the LangGraph supervisor's routing decision, LlamaIndex's RAG/SQL answer
# synthesis, CrewAI's writer + reviewer, and (unless ADK_MODEL below
# overrides it) the Google ADK agents too.
#   anthropic (default) -> uses ANTHROPIC_API_KEY / ANTHROPIC_MODEL
#   openai              -> uses OPENAI_API_KEY / OPENAI_MODEL
LLM_PROVIDER=anthropic

# --- Anthropic (used when LLM_PROVIDER=anthropic, the default) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Local embedding model for LlamaIndex (no API key needed - runs on your
# own machine via sentence-transformers).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional - ADK agent model override. If left unset, ADK agents
# automatically match LLM_PROVIDER above (via LiteLLM), so normally you
# don't need to touch this. Set it explicitly only to run the ADK agents on
# a different provider than everything else, e.g. Gemini:
#   ADK_MODEL=gemini-2.0-flash
#   GOOGLE_API_KEY=your-google-key
# ADK_MODEL=
GOOGLE_API_KEY=

# Optional - ADK A2A service ports / URLs (defaults shown)
NETWORK_DIAGNOSTICS_PORT=8001
BILLING_RESOLUTION_PORT=8002
NETWORK_DIAGNOSTICS_AGENT_URL=http://localhost:8001
BILLING_RESOLUTION_AGENT_URL=http://localhost:8002
